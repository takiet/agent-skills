# Device credentials for the building-acap scripts.
# Copy this file to the root of your ACAP project as `.env` and fill it in.
# The scripts source it from the current working directory, so it must sit at
# the project root — the same place you run `make build` from.

# Device host name or IP address
DEVICE=192.168.0.90

# Application name. Must match `appName` in app/manifest.json.
APP_NAME=hello_world

# Account used for web / VAPIX access (install, start/stop, logs)
WEB_USER=root
WEB_PASS=

# SSH user for running test binaries on the device. Installing the app creates
# a user named after the app, so this normally needs no editing.
SSH_USER=${APP_NAME}

# SSH password used during development. Choose one here, then apply it to the
# device with `bash scripts/setup_ssh.sh` after the first install.
SSH_PASS=
